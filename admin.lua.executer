--==================================================
-- LOCAL-HALF TEST SCRIPT
-- Roblox-style Luau API
--==================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

--==================================================
-- SETTINGS
--==================================================

local BoneESP = false
local HealthESP = false
local SelectedPlayer = nil
local FlingPower = 250

local ESPObjects = {}

--==================================================
-- GUI
--==================================================

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "LocalHalfGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Main = Instance.new("Frame")
Main.Name = "Main"
Main.Size = UDim2.fromOffset(260, 390)
Main.Position = UDim2.fromOffset(30, 120)
Main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Main.BorderSizePixel = 0
Main.Active = true
Main.Draggable = true
Main.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Text = "LOCAL-HALF"
Title.TextSize = 18
Title.Parent = Main

local function CreateButton(text, y)
    local button = Instance.new("TextButton")

    button.Size = UDim2.new(1, -20, 0, 35)
    button.Position = UDim2.fromOffset(10, y)
    button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = text
    button.TextSize = 14
    button.BorderSizePixel = 0
    button.Parent = Main

    return button
end

local BoneButton = CreateButton("Bone ESP: OFF", 50)
local HealthButton = CreateButton("Health ESP: OFF", 90)
local FlingButton = CreateButton("FLING SELECTED", 130)

--==================================================
-- PLAYER LIST
--==================================================

local PlayerList = Instance.new("ScrollingFrame")

PlayerList.Size = UDim2.new(1, -20, 0, 205)
PlayerList.Position = UDim2.fromOffset(10, 175)
PlayerList.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
PlayerList.BorderSizePixel = 0
PlayerList.ScrollBarThickness = 5
PlayerList.CanvasSize = UDim2.fromOffset(0, 0)
PlayerList.Parent = Main

local function RefreshPlayerList()

    for _, object in ipairs(PlayerList:GetChildren()) do
        if object:IsA("TextButton") then
            object:Destroy()
        end
    end

    local y = 5

    for _, target in ipairs(Players:GetPlayers()) do

        if target ~= LocalPlayer then

            local button = Instance.new("TextButton")

            button.Size = UDim2.new(1, -10, 0, 30)
            button.Position = UDim2.fromOffset(5, y)
            button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.Text = target.Name
            button.TextSize = 13
            button.BorderSizePixel = 0
            button.Parent = PlayerList

            button.MouseButton1Click:Connect(function()

                SelectedPlayer = target
                Title.Text = "TARGET: " .. target.Name

            end)

            y = y + 35
        end
    end

    PlayerList.CanvasSize = UDim2.fromOffset(0, y)
end

RefreshPlayerList()

Players.PlayerAdded:Connect(function()
    task.wait(0.1)
    RefreshPlayerList()
end)

Players.PlayerRemoving:Connect(function(target)

    if SelectedPlayer == target then
        SelectedPlayer = nil
        Title.Text = "LOCAL-HALF"
    end

    if ESPObjects[target] then

        for _, object in ipairs(ESPObjects[target]) do
            if object and object.Parent then
                object:Destroy()
            end
        end

        ESPObjects[target] = nil
    end

    RefreshPlayerList()
end)

--==================================================
-- TOGGLES
--==================================================

BoneButton.MouseButton1Click:Connect(function()

    BoneESP = not BoneESP

    BoneButton.Text =
        BoneESP and "Bone ESP: ON"
        or "Bone ESP: OFF"

end)

HealthButton.MouseButton1Click:Connect(function()

    HealthESP = not HealthESP

    HealthButton.Text =
        HealthESP and "Health ESP: ON"
        or "Health ESP: OFF"

end)

--==================================================
-- R6 + R15 BONE MAP
--==================================================

local BonePairs = {

    -- R6
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},

    -- R15
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},

    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},

    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},

    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},

    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

--==================================================
-- SAFE HELPERS
--==================================================

local function GetCharacter(target)

    if not target then
        return nil
    end

    local character = target.Character

    if not character or not character.Parent then
        return nil
    end

    return character
end

local function GetPart(character, name)

    if not character then
        return nil
    end

    return character:FindFirstChild(name)
end

local function GetAttachment(part, name)

    if not part then
        return nil
    end

    local attachment = part:FindFirstChild(name)

    if attachment then
        return attachment
    end

    attachment = Instance.new("Attachment")
    attachment.Name = name
    attachment.Parent = part

    return attachment
end

--==================================================
-- BONE ESP
--==================================================

local function RemoveBoneESP(target)

    local objects = ESPObjects[target]

    if not objects then
        return
    end

    for _, object in ipairs(objects) do

        if object and object.Parent then
            object:Destroy()
        end

    end

    ESPObjects[target] = nil
end

local function CreateBoneESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    RemoveBoneESP(target)

    ESPObjects[target] = {}

    for _, pair in ipairs(BonePairs) do

        local partA = GetPart(character, pair[1])
        local partB = GetPart(character, pair[2])

        if partA and partB then

            local attachmentA =
                GetAttachment(partA, "LocalHalf_A")

            local attachmentB =
                GetAttachment(partB, "LocalHalf_B")

            if attachmentA and attachmentB then

                local beam = Instance.new("Beam")

                beam.Name = "LocalHalfBone"
                beam.Attachment0 = attachmentA
                beam.Attachment1 = attachmentB
                beam.Width0 = 0.06
                beam.Width1 = 0.06
                beam.FaceCamera = true
                beam.Parent = character

                table.insert(
                    ESPObjects[target],
                    beam
                )
            end
        end
    end
end

--==================================================
-- HEALTH ESP
--==================================================

local function RemoveHealthESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head then
        return
    end

    local billboard =
        head:FindFirstChild("LocalHalfHealth")

    if billboard then
        billboard:Destroy()
    end
end

local function CreateHealthESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    local billboard =
        head:FindFirstChild("LocalHalfHealth")

    if not billboard then

        billboard = Instance.new("BillboardGui")

        billboard.Name = "LocalHalfHealth"
        billboard.Size = UDim2.fromOffset(180, 45)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head

        local label = Instance.new("TextLabel")

        label.Name = "HealthLabel"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Parent = billboard
    end

    local label =
        billboard:FindFirstChild("HealthLabel")

    if label then

        label.Text =
            target.Name ..
            "\nHP: " ..
            math.floor(humanoid.Health) ..
            "/" ..
            math.floor(humanoid.MaxHealth)

    end
end

--==================================================
-- FLING
--==================================================

local function FlingSelected()

    if not SelectedPlayer then
        Title.Text = "NO TARGET"
        return
    end

    local character =
        GetCharacter(SelectedPlayer)

    if not character then
        Title.Text = "TARGET HAS NO CHARACTER"
        return
    end

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not root then
        Title.Text = "NO ROOT PART"
        return
    end

    -- Uses the physics behavior provided
    -- by your local-half environment.

    root.AssemblyLinearVelocity =
        Vector3.new(
            math.random(-FlingPower, FlingPower),
            FlingPower,
            math.random(-FlingPower, FlingPower)
        )
end

FlingButton.MouseButton1Click:Connect(FlingSelected)

--==================================================
-- CHARACTER RESPAWN
--==================================================

local function CharacterChanged(target)

    if target == LocalPlayer then
        return
    end

    if ESPObjects[target] then
        RemoveBoneESP(target)
    end

    task.wait(0.25)

    if BoneESP then
        CreateBoneESP(target)
    end
end

for _, target in ipairs(Players:GetPlayers()) do

    if target ~= LocalPlayer then

        target.CharacterAdded:Connect(function()
            CharacterChanged(target)
        end)

    end
end

Players.PlayerAdded:Connect(function(target)

    target.CharacterAdded:Connect(function()
        CharacterChanged(target)
    end)

end)

--==================================================
-- MAIN UPDATE
--==================================================

RunService.Heartbeat:Connect(function()

    for _, target in ipairs(Players:GetPlayers()) do

        if target ~= LocalPlayer then

            local character = GetCharacter(target)

            if character then

                -- Bone ESP
                if BoneESP then

                    if not ESPObjects[target] then
                        CreateBoneESP(target)
                    end

                else

                    if ESPObjects[target] then
                        RemoveBoneESP(target)
                    end

                end

                -- Health ESP
                if HealthESP then
                    CreateHealthESP(target)
                else
                    RemoveHealthESP(target)
                end

            end
        end
    end
end)
