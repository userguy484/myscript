--==================================================
-- LOCAL-HALF / LOADSTRING VERSION
-- Roblox-style Luau API
--==================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then
    warn("LocalPlayer is nil")
    return
end

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

--==================================================
-- SETTINGS
--==================================================

local BoneESP = false
local HealthESP = false
local SelectedPlayer = nil
local FlingPower = 250

local BoneObjects = {}

--==================================================
-- CHARACTER
--==================================================

local function GetCharacter(player)
    if not player then
        return nil
    end

    local character = player.Character

    if character and character.Parent then
        return character
    end

    return nil
end

--==================================================
-- GUI
--==================================================

local OldGui = PlayerGui:FindFirstChild("LocalHalfGUI")

if OldGui then
    OldGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "LocalHalfGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Main = Instance.new("Frame")
Main.Name = "Main"
Main.Size = UDim2.fromOffset(270, 420)
Main.Position = UDim2.fromOffset(30, 120)
Main.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Main.BorderSizePixel = 0
Main.Active = true
Main.Draggable = true
Main.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
Title.BorderSizePixel = 0
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Text = "LOCAL-HALF"
Title.TextSize = 18
Title.Parent = Main

local function MakeButton(text, y)
    local button = Instance.new("TextButton")

    button.Size = UDim2.new(1, -20, 0, 35)
    button.Position = UDim2.fromOffset(10, y)
    button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = text
    button.TextSize = 14
    button.Parent = Main

    return button
end

local BoneButton = MakeButton("Bone ESP: OFF", 50)
local HealthButton = MakeButton("Health ESP: OFF", 90)
local FlingButton = MakeButton("FLING SELECTED", 130)

--==================================================
-- PLAYER LIST
--==================================================

local PlayerList = Instance.new("ScrollingFrame")
PlayerList.Name = "PlayerList"
PlayerList.Size = UDim2.new(1, -20, 0, 240)
PlayerList.Position = UDim2.fromOffset(10, 175)
PlayerList.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
PlayerList.BorderSizePixel = 0
PlayerList.ScrollBarThickness = 5
PlayerList.CanvasSize = UDim2.fromOffset(0, 0)
PlayerList.Parent = Main

local function RefreshPlayerList()

    for _, object in ipairs(PlayerList:GetChildren()) do
        if object:IsA("TextButton") then
            object:Destroy()
        end
    end

    local y = 5

    for _, target in ipairs(Players:GetPlayers()) do

        if target ~= LocalPlayer then

            local button = Instance.new("TextButton")

            button.Size = UDim2.new(1, -10, 0, 30)
            button.Position = UDim2.fromOffset(5, y)
            button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            button.BorderSizePixel = 0
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.Text = target.Name
            button.TextSize = 13
            button.Parent = PlayerList

            button.MouseButton1Click:Connect(function()
                SelectedPlayer = target
                Title.Text = "TARGET: " .. target.Name
            end)

            y = y + 35
        end
    end

    PlayerList.CanvasSize = UDim2.fromOffset(0, y)
end

RefreshPlayerList()

Players.PlayerAdded:Connect(function()
    task.wait(0.1)
    RefreshPlayerList()
end)

Players.PlayerRemoving:Connect(function(target)

    if SelectedPlayer == target then
        SelectedPlayer = nil
        Title.Text = "LOCAL-HALF"
    end

    if BoneObjects[target] then

        for _, object in ipairs(BoneObjects[target]) do
            if object and object.Parent then
                object:Destroy()
            end
        end

        BoneObjects[target] = nil
    end

    RefreshPlayerList()
end)

--==================================================
-- ESP TOGGLES
--==================================================

BoneButton.MouseButton1Click:Connect(function()

    BoneESP = not BoneESP

    BoneButton.Text =
        BoneESP and "Bone ESP: ON"
        or "Bone ESP: OFF"

end)

HealthButton.MouseButton1Click:Connect(function()

    HealthESP = not HealthESP

    HealthButton.Text =
        HealthESP and "Health ESP: ON"
        or "Health ESP: OFF"

end)

--==================================================
-- BONE MAP
--==================================================

local BonePairs = {

    -- R6
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},

    -- R15
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},

    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},

    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},

    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},

    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

--==================================================
-- SAFE ATTACHMENT
--==================================================

local function GetAttachment(part, name)

    if not part then
        return nil
    end

    local attachment = part:FindFirstChild(name)

    if attachment then
        return attachment
    end

    attachment = Instance.new("Attachment")
    attachment.Name = name
    attachment.Parent = part

    return attachment
end

--==================================================
-- REMOVE BONE ESP
--==================================================

local function RemoveBoneESP(target)

    local objects = BoneObjects[target]

    if not objects then
        return
    end

    for _, object in ipairs(objects) do

        if object and object.Parent then
            object:Destroy()
        end

    end

    BoneObjects[target] = nil
end

--==================================================
-- CREATE BONE ESP
--==================================================

local function CreateBoneESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    RemoveBoneESP(target)

    BoneObjects[target] = {}

    for _, pair in ipairs(BonePairs) do

        local partA = character:FindFirstChild(pair[1])
        local partB = character:FindFirstChild(pair[2])

        if partA and partB then

            local attachmentA =
                GetAttachment(partA, "LocalHalf_A")

            local attachmentB =
                GetAttachment(partB, "LocalHalf_B")

            if attachmentA and attachmentB then

                local beam = Instance.new("Beam")

                beam.Name = "LocalHalfBone"
                beam.Attachment0 = attachmentA
                beam.Attachment1 = attachmentB
                beam.Width0 = 0.06
                beam.Width1 = 0.06
                beam.FaceCamera = true
                beam.Parent = character

                table.insert(
                    BoneObjects[target],
                    beam
                )
            end
        end
    end
end

--==================================================
-- HEALTH ESP
--==================================================

local function RemoveHealthESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head then
        return
    end

    local billboard =
        head:FindFirstChild("LocalHalfHealth")

    if billboard then
        billboard:Destroy()
    end
end

local function UpdateHealthESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    local billboard =
        head:FindFirstChild("LocalHalfHealth")

    if not billboard then

        billboard = Instance.new("BillboardGui")

        billboard.Name = "LocalHalfHealth"
        billboard.Size = UDim2.fromOffset(180, 45)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head

        local label = Instance.new("TextLabel")

        label.Name = "HealthLabel"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0
        label.TextScaled = true
        label.Parent = billboard
    end

    local label =
        billboard:FindFirstChild("HealthLabel")

    if label then

        local health = humanoid.Health
        local maxHealth = humanoid.MaxHealth

        label.Text =
            target.Name ..
            "\nHP: " ..
            math.floor(health) ..
            "/" ..
            math.floor(maxHealth)

    end
end

--==================================================
-- FLING
--==================================================

local function FlingSelected()

    if not SelectedPlayer then
        Title.Text = "NO TARGET"
        return
    end

    local character =
        GetCharacter(SelectedPlayer)

    if not character then
        Title.Text = "TARGET HAS NO CHARACTER"
        return
    end

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not root then
        Title.Text = "NO ROOT PART"
        return
    end

    root.AssemblyLinearVelocity = Vector3.new(
        math.random(-FlingPower, FlingPower),
        FlingPower,
        math.random(-FlingPower, FlingPower)
    )

    Title.Text = "FLUNG: " .. SelectedPlayer.Name
end

FlingButton.MouseButton1Click:Connect(FlingSelected)

--==================================================
-- RESPAWN HANDLING
--==================================================

local function SetupPlayer(target)

    if target == LocalPlayer then
        return
    end

    target.CharacterAdded:Connect(function()

        task.wait(0.25)

        if BoneESP then
            CreateBoneESP(target)
        end

    end)
end

for _, target in ipairs(Players:GetPlayers()) do
    SetupPlayer(target)
end

Players.PlayerAdded:Connect(SetupPlayer)

--==================================================
-- MAIN UPDATE
--==================================================

RunService.Heartbeat:Connect(function()

    for _, target in ipairs(Players:GetPlayers()) do

        if target ~= LocalPlayer then

            local character = GetCharacter(target)

            if character then

                -- Bone ESP
                if BoneESP then

                    if not BoneObjects[target] then
                        CreateBoneESP(target)
                    end

                elseif BoneObjects[target] then

                    RemoveBoneESP(target)

                end

                -- Health ESP
                if HealthESP then
                    UpdateHealthESP(target)
                else
                    RemoveHealthESP(target)
                end

            end
        end
    end
end)
