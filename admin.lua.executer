--==================================================
-- PLAYER LIST
--==================================================

local PlayerTitle = Instance.new("TextLabel")
PlayerTitle.Position = UDim2.new(0, 165, 0, 72)
PlayerTitle.Size = UDim2.new(0, 145, 0, 25)
PlayerTitle.BackgroundTransparency = 1
PlayerTitle.Text = "PLAYERS"
PlayerTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
PlayerTitle.TextSize = 15
PlayerTitle.Font = Enum.Font.SourceSansBold
PlayerTitle.Parent = Main

local PlayerList = Instance.new("ScrollingFrame")
PlayerList.Name = "PlayerList"
PlayerList.Position = UDim2.new(0, 165, 0, 100)
PlayerList.Size = UDim2.new(0, 145, 0, 350)
PlayerList.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
PlayerList.BorderSizePixel = 0
PlayerList.ScrollBarThickness = 5
PlayerList.CanvasSize = UDim2.new(0, 0, 0, 0)
PlayerList.Parent = Main

local ListLayout = Instance.new("UIListLayout")
ListLayout.Padding = UDim.new(0, 4)
ListLayout.Parent = PlayerList

local function selectPlayer(player)
    if not player or player == LocalPlayer then
        return
    end

    SelectedPlayer = player
    SelectedLabel.Text = "Selected: " .. tostring(player.Name)
end

local function refreshPlayerList()
    for _, child in ipairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            safeDestroy(child)
        end
    end

    local allPlayers = Players:GetPlayers()

    for _, player in ipairs(allPlayers) do
        if player ~= LocalPlayer then
            local Button = Instance.new("TextButton")
            Button.Size = UDim2.new(1, -10, 0, 30)
            Button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            Button.BorderSizePixel = 0
            Button.Text = tostring(player.Name)
            Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            Button.TextSize = 13
            Button.Font = Enum.Font.SourceSans
            Button.Parent = PlayerList

            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 4)
            c.Parent = Button

            Button.MouseButton1Click:Connect(function()
                selectPlayer(player)
            end)
        end
    end

    task.defer(function()
        pcall(function()
            PlayerList.CanvasSize = UDim2.new(
                0,
                0,
                0,
                ListLayout.AbsoluteContentSize.Y + 10
            )
        end)
    end)
end

Players.PlayerAdded:Connect(refreshPlayerList)

Players.PlayerRemoving:Connect(function(player)
    if SelectedPlayer == player then
        SelectedPlayer = nil
        SelectedLabel.Text = "Selected: None"

        if Spectating then
            Spectating = false

            local camera = workspace.CurrentCamera
            local humanoid = getHumanoid(LocalPlayer)

            if camera and humanoid then
                camera.CameraSubject = humanoid
            end

            ViewButton.Text = "View Player"
        end
    end

    refreshPlayerList()
end)

refreshPlayerList()

--==================================================
-- BONE ESP
--==================================================

local BonePairs = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

local R6Pairs = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"}
}

local function removeBoneESP(player)
    local data = BoneObjects[player]

    if not data then
        return
    end

    for _, object in ipairs(data) do
        safeDestroy(object)
    end

    BoneObjects[player] = nil
end

local function createBoneESP(player)
    if not BoneESPEnabled then
        return
    end

    if not player or player == LocalPlayer then
        return
    end

    local character = getCharacter(player)

    if not character then
        return
    end

    removeBoneESP(player)

    local objects = {}

    local pairsToUse = BonePairs

    if character:FindFirstChild("Torso") then
        pairsToUse = R6Pairs
    end

    for _, pair in ipairs(pairsToUse) do
        local part0 = character:FindFirstChild(pair[1])
        local part1 = character:FindFirstChild(pair[2])

        if part0 and part1 then
            local a0 = Instance.new("Attachment")
            a0.Name = "LH_BoneA"
            a0.Parent = part0

            local a1 = Instance.new("Attachment")
            a1.Name = "LH_BoneB"
            a1.Parent = part1

            local beam = Instance.new("Beam")
            beam.Name = "LH_Bone"
            beam.Attachment0 = a0
            beam.Attachment1 = a1
            beam.Width0 = 0.08
            beam.Width1 = 0.08
            beam.FaceCamera = true
            beam.Parent = part0

            table.insert(objects, beam)
            table.insert(objects, a0)
            table.insert(objects, a1)
        end
    end

    BoneObjects[player] = objects
end

local function updateBoneESP()
    if not BoneESPEnabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = getCharacter(player)

            if character then
                local existing = BoneObjects[player]

                if not existing or #existing == 0 then
                    createBoneESP(player)
                end
            end
        end
    end
end

local function clearAllBones()
    for player in pairs(BoneObjects) do
        removeBoneESP(player)
    end
end

BoneButton.MouseButton1Click:Connect(function()
    BoneESPEnabled = not BoneESPEnabled

    BoneButton.Text = BoneESPEnabled and "Bone ESP: ON" or "Bone ESP: OFF"

    if BoneESPEnabled then
        updateBoneESP()
    else
        clearAllBones()
    end
end)

--==================================================
-- HEALTH ESP
--==================================================

local function removeHealthESP(player)
    local object = HealthObjects[player]

    if object then
        safeDestroy(object)
    end

    HealthObjects[player] = nil
end

local function createHealthESP(player)
    if not HealthESPEnabled then
        return
    end

    local character = getCharacter(player)

    if not character then
        return
    end

    local head = character:FindFirstChild("Head")
    local humanoid = getHumanoid(player)

    if not head or not humanoid then
        return
    end

    removeHealthESP(player)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "LH_HealthESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 120, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Name = "Health"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextSize = 14
    label.Font = Enum.Font.SourceSansBold
    label.Parent = billboard

    HealthObjects[player] = billboard
end

local function updateHealthESP()
    if not HealthESPEnabled then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local humanoid = getHumanoid(player)
            local gui = HealthObjects[player]

            if humanoid then
                if not gui then
                    createHealthESP(player)
                    gui = HealthObjects[player]
                end

                if gui then
                    local label = gui:FindFirstChild("Health")

                    if label then
                        local health = humanoid.Health
                        local maxHealth = humanoid.MaxHealth

                        if maxHealth and maxHealth > 0 then
                            label.Text = string.format(
                                "%s | %d/%d",
                                tostring(player.Name),
                                math.floor(health),
                                math.floor(maxHealth)
                            )
                        end
                    end
                end
            end
        end
    end
end

local function clearAllHealth()
    for player in pairs(HealthObjects) do
        removeHealthESP(player)
    end
end

HealthButton.MouseButton1Click:Connect(function()
    HealthESPEnabled = not HealthESPEnabled

    HealthButton.Text =
        HealthESPEnabled and "Health ESP: ON" or "Health ESP: OFF"

    if HealthESPEnabled then
        updateHealthESP()
    else
        clearAllHealth()
    end
end)

--==================================================
-- FLY
--==================================================

local FlyConnection = nil

local function stopFly()
    FlyEnabled = false
    FlyButton.Text = "Fly: OFF"

    if FlyConnection then
        pcall(function()
            FlyConnection:Disconnect()
        end)

        FlyConnection = nil
    end

    local root = getRoot(LocalPlayer)

    if root then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
        end)
    end
end

local function startFly()
    if FlyEnabled then
        return
    end

    FlyEnabled = true
    FlyButton.Text = "Fly: ON"

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not FlyEnabled then
            return
        end

        local root = getRoot(LocalPlayer)
        local camera = workspace.CurrentCamera

        if not root or not camera then
            return
        end

        local direction = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction += camera.CFrame.LookVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction -= camera.CFrame.LookVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction += camera.CFrame.RightVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction -= camera.CFrame.RightVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.new(0, 1, 0)
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.new(0, 1, 0)
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit * FlySpeed
        end

        pcall(function()
            root.AssemblyLinearVelocity = direction
        end)
    end)
end

FlyButton.MouseButton1Click:Connect(function()
    if FlyEnabled then
        stopFly()
    else
        startFly()
    end
end)

--==================================================
-- NOCLIP
--==================================================

local function setNoclip(enabled)
    NoclipEnabled = enabled

    local character = getCharacter(LocalPlayer)

    if not character then
        return
    end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            if enabled then
                if CollisionCache[object] == nil then
                    CollisionCache[object] = object.CanCollide
                end

                pcall(function()
                    object.CanCollide = false
                end)
            else
                local old = CollisionCache[object]

                if old ~= nil then
                    pcall(function()
                        object.CanCollide = old
                    end)

                    CollisionCache[object] = nil
                end
            end
        end
    end
end

NoclipButton.MouseButton1Click:Connect(function()
    NoclipEnabled = not NoclipEnabled

    NoclipButton.Text =
        NoclipEnabled and "Noclip: ON" or "Noclip: OFF"

    setNoclip(NoclipEnabled)
end)

--==================================================
-- SPECTATE
--==================================================

ViewButton.MouseButton1Click:Connect(function()
    if Spectating then
        Spectating = false
        ViewButton.Text = "View Player"

        local camera = workspace.CurrentCamera
        local humanoid = getHumanoid(LocalPlayer)

        if camera and humanoid then
            pcall(function()
                camera.CameraSubject = humanoid
            end)
        end

        return
    end

    if not SelectedPlayer then
        return
    end

    local humanoid = getHumanoid(SelectedPlayer)

    if not humanoid then
        return
    end

    local camera = workspace.CurrentCamera

    if camera then
        pcall(function()
            camera.CameraSubject = humanoid
        end)

        Spectating = true
        ViewButton.Text = "Stop Viewing"
    end
end)

--==================================================
-- TELEPORT
--==================================================

TeleportButton.MouseButton1Click:Connect(function()
    if not SelectedPlayer then
        return
    end

    local myRoot = getRoot(LocalPlayer)
    local targetRoot = getRoot(SelectedPlayer)

    if not myRoot or not targetRoot then
        return
    end

    pcall(function()
        myRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
    end)
end)

--==================================================
-- FLING SELECTED PLAYER
--==================================================
-- Intended for your own Local-Half game/admin testing.
-- Targets SelectedPlayer, never LocalPlayer.

local function flingPlayer(targetPlayer)
    if not targetPlayer then
        return false
    end

    if targetPlayer == LocalPlayer then
        return false
    end

    local targetRoot = getRoot(targetPlayer)

    if not targetRoot then
        return false
    end

    local myRoot = getRoot(LocalPlayer)

    if not myRoot then
        return false
    end

    local direction = targetRoot.Position - myRoot.Position

    if direction.Magnitude < 0.1 then
        direction = Vector3.new(0, 1, 0)
    else
        direction = direction.Unit
    end

    -- Apply a strong impulse to the selected player's root.
    pcall(function()
        if targetRoot.ApplyImpulse then
            targetRoot:ApplyImpulse(
                direction * targetRoot.AssemblyMass * FlingPower
                + Vector3.new(0, targetRoot.AssemblyMass * FlingPower * 0.35, 0)
            )
        end
    end)

    -- Also set velocity for engines that support AssemblyLinearVelocity.
    pcall(function()
        targetRoot.AssemblyLinearVelocity =
            direction * FlingPower
            + Vector3.new(0, FlingPower * 0.35, 0)
    end)

    pcall(function()
        targetRoot.AssemblyAngularVelocity =
            Vector3.new(
                FlingPower * 0.5,
                FlingPower,
                FlingPower * 0.5
            )
    end)

    return true
end

FlingButton.MouseButton1Click:Connect(function()
    if not SelectedPlayer then
        FlingButton.Text = "Select Player!"
        task.delay(1, function()
            if FlingButton then
                FlingButton.Text = "Fling Selected"
            end
        end)
        return
    end

    if SelectedPlayer == LocalPlayer then
        return
    end

    local success = flingPlayer(SelectedPlayer)

    if success then
        FlingButton.Text = "FLUNG!"

        task.delay(0.7, function()
            if FlingButton then
                FlingButton.Text = "Fling Selected"
            end
        end)
    else
        FlingButton.Text = "Target Invalid"

        task.delay(1, function()
            if FlingButton then
                FlingButton.Text = "Fling Selected"
            end
        end)
    end
end)

--==================================================
-- CHARACTER RESPAWN
--==================================================

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)

    CollisionCache = {}

    if NoclipEnabled then
        setNoclip(true)
    end

    if FlyEnabled then
        stopFly()
    end

    if Spectating then
        Spectating = false
        ViewButton.Text = "View Player"
    end
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function()
            task.wait(0.3)

            removeBoneESP(player)
            removeHealthESP(player)

            if BoneESPEnabled then
                createBoneESP(player)
            end

            if HealthESPEnabled then
                createHealthESP(player)
            end
        end)
    end
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.3)

        if BoneESPEnabled then
            createBoneESP(player)
        end

        if HealthESPEnabled then
            createHealthESP(player)
        end
    end)
end)

--==================================================
-- MAIN UPDATE
--==================================================

RunService.Heartbeat:Connect(function()
    if NoclipEnabled then
        setNoclip(true)
    end

    if BoneESPEnabled then
        updateBoneESP()
    end

    if HealthESPEnabled then
        updateHealthESP()
    end

    -- Keep spectating the selected player's current character.
    if Spectating and SelectedPlayer then
        local camera = workspace.CurrentCamera
        local humanoid = getHumanoid(SelectedPlayer)

        if camera and humanoid then
            pcall(function()
                camera.CameraSubject = humanoid
            end)
        end
    end
end)

--==================================================
-- INITIAL STATE
--==================================================

SelectedLabel.Text = "Selected: None"
BoneButton.Text = "Bone ESP: OFF"
HealthButton.Text = "Health ESP: OFF"
FlyButton.Text = "Fly: OFF"
NoclipButton.Text = "Noclip: OFF"

print("Local-Half panel loaded successfully.")
