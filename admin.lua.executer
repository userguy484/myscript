--==================================================
-- LOCAL-HALF COMPLETE ADMIN / TEST GUI
--==================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then
    warn("LocalPlayer is nil")
    return
end

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

--==================================================
-- SETTINGS
--==================================================

local BoneESP = false
local HealthESP = false
local Noclip = false
local Flying = false
local Spectating = false

local SelectedPlayer = nil

local FlySpeed = 60
local FlingPower = 250

local BoneObjects = {}
local Connections = {}

local FlyUp = false
local FlyDown = false

--==================================================
-- CHARACTER HELPERS
--==================================================

local function GetCharacter(player)
    if not player then
        return nil
    end

    local character = player.Character

    if character and character.Parent then
        return character
    end

    return nil
end

local function GetRoot(character)
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
end

local function GetHumanoid(character)
    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

--==================================================
-- REMOVE OLD GUI
--==================================================

local OldGui = PlayerGui:FindFirstChild("LocalHalfGUI")

if OldGui then
    OldGui:Destroy()
end

--==================================================
-- GUI
--==================================================

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "LocalHalfGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Main = Instance.new("Frame")
Main.Name = "Main"
Main.Size = UDim2.fromOffset(290, 520)
Main.Position = UDim2.fromOffset(30, 100)
Main.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Main.BorderSizePixel = 0
Main.Active = true
Main.Parent = ScreenGui

--==================================================
-- DRAGGING
--==================================================

local Dragging = false
local DragStart
local StartPosition

local function UpdateDrag(input)
    local Delta = input.Position - DragStart

    Main.Position = UDim2.new(
        StartPosition.X.Scale,
        StartPosition.X.Offset + Delta.X,
        StartPosition.Y.Scale,
        StartPosition.Y.Offset + Delta.Y
    )
end

Main.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        Dragging = true
        DragStart = input.Position
        StartPosition = Main.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end

        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)

    if Dragging then

        if input.UserInputType == Enum.UserInputType.MouseMovement then
            UpdateDrag(input)
        end

    end

end)

--==================================================
-- TITLE
--==================================================

local Title = Instance.new("TextLabel")
Title.Name = "Title"
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
Title.BorderSizePixel = 0
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Text = "LOCAL-HALF"
Title.TextSize = 18
Title.Parent = Main

--==================================================
-- BUTTON CREATOR
--==================================================

local function MakeButton(text, y)

    local button = Instance.new("TextButton")

    button.Size = UDim2.new(1, -20, 0, 32)
    button.Position = UDim2.fromOffset(10, y)

    button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    button.BorderSizePixel = 0

    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = text
    button.TextSize = 13

    button.Parent = Main

    return button
end

local BoneButton = MakeButton("Bone ESP: OFF", 50)
local HealthButton = MakeButton("Health ESP: OFF", 87)
local FlyButton = MakeButton("Fly: OFF", 124)
local NoclipButton = MakeButton("Noclip: OFF", 161)

local ViewButton = MakeButton("View Selected", 198)
local TeleportButton = MakeButton("Teleport To Selected", 235)
local FlingButton = MakeButton("Fling Selected", 272)

--==================================================
-- PLAYER LIST
--==================================================

local PlayerList = Instance.new("ScrollingFrame")

PlayerList.Name = "PlayerList"

PlayerList.Size = UDim2.new(1, -20, 0, 210)
PlayerList.Position = UDim2.fromOffset(10, 312)

PlayerList.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
PlayerList.BorderSizePixel = 0

PlayerList.ScrollBarThickness = 6
PlayerList.CanvasSize = UDim2.fromOffset(0, 0)

PlayerList.Parent = Main

--==================================================
-- SELECT PLAYER
--==================================================

local function SetSelectedPlayer(player)

    SelectedPlayer = player

    if player then
        Title.Text = "TARGET: " .. player.Name
    else
        Title.Text = "LOCAL-HALF"
    end

end

--==================================================
-- PLAYER LIST REFRESH
--==================================================

local function RefreshPlayerList()

    for _, object in ipairs(PlayerList:GetChildren()) do

        if object:IsA("TextButton") then
            object:Destroy()
        end

    end

    local y = 5

    for _, target in ipairs(Players:GetPlayers()) do

        if target ~= LocalPlayer then

            local button = Instance.new("TextButton")

            button.Size = UDim2.new(1, -10, 0, 30)
            button.Position = UDim2.fromOffset(5, y)

            button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            button.BorderSizePixel = 0

            button.TextColor3 = Color3.fromRGB(255, 255, 255)

            button.Text = target.Name
            button.TextSize = 13

            button.Parent = PlayerList

            button.MouseButton1Click:Connect(function()

                SetSelectedPlayer(target)

            end)

            y = y + 35

        end

    end

    PlayerList.CanvasSize = UDim2.fromOffset(0, y)

end

RefreshPlayerList()

--==================================================
-- BONE MAP
--==================================================

local BonePairs = {

    -- R6

    {"Head", "Torso"},

    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},

    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},

    -- R15

    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},

    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},

    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},

    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},

    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}

--==================================================
-- ATTACHMENT
--==================================================

local function GetAttachment(part, name)

    if not part then
        return nil
    end

    local attachment = part:FindFirstChild(name)

    if attachment then
        return attachment
    end

    local newAttachment = Instance.new("Attachment")

    newAttachment.Name = name
    newAttachment.Parent = part

    return newAttachment

end

--==================================================
-- REMOVE BONE ESP
--==================================================

local function RemoveBoneESP(target)

    local objects = BoneObjects[target]

    if not objects then
        return
    end

    for _, object in ipairs(objects) do

        if object and object.Parent then
            object:Destroy()
        end

    end

    BoneObjects[target] = nil

end

--==================================================
-- CREATE BONE ESP
--==================================================

local function CreateBoneESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    RemoveBoneESP(target)

    BoneObjects[target] = {}

    for _, pair in ipairs(BonePairs) do

        local partA = character:FindFirstChild(pair[1])
        local partB = character:FindFirstChild(pair[2])

        if partA and partB then

            local attachmentA =
                GetAttachment(partA, "LocalHalf_A")

            local attachmentB =
                GetAttachment(partB, "LocalHalf_B")

            if attachmentA and attachmentB then

                local beam = Instance.new("Beam")

                beam.Name = "LocalHalfBone"

                beam.Attachment0 = attachmentA
                beam.Attachment1 = attachmentB

                beam.Width0 = 0.06
                beam.Width1 = 0.06

                beam.FaceCamera = true

                beam.Parent = character

                table.insert(
                    BoneObjects[target],
                    beam
                )

            end

        end

    end

end

--==================================================
-- HEALTH ESP REMOVE
--==================================================

local function RemoveHealthESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head then
        return
    end

    local billboard =
        head:FindFirstChild("LocalHalfHealth")

    if billboard then
        billboard:Destroy()
    end

end

--==================================================
-- HEALTH ESP
--==================================================

local function UpdateHealthESP(target)

    local character = GetCharacter(target)

    if not character then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head then
        return
    end

    local humanoid = GetHumanoid(character)

    if not humanoid then
        return
    end

    local billboard =
        head:FindFirstChild("LocalHalfHealth")

    if not billboard then

        billboard = Instance.new("BillboardGui")

        billboard.Name = "LocalHalfHealth"

        billboard.Size =
            UDim2.fromOffset(180, 45)

        billboard.StudsOffset =
            Vector3.new(0, 3, 0)

        billboard.AlwaysOnTop = true

        billboard.Parent = head

        local label = Instance.new("TextLabel")

        label.Name = "HealthLabel"

        label.Size =
            UDim2.fromScale(1, 1)

        label.BackgroundTransparency = 1

        label.TextColor3 =
            Color3.fromRGB(255, 255, 255)

        label.TextStrokeTransparency = 0

        label.TextScaled = true

        label.Parent = billboard

    end

    local label =
        billboard:FindFirstChild("HealthLabel")

    if label then

        local health =
            math.floor(humanoid.Health)

        local maxHealth =
            math.floor(humanoid.MaxHealth)

        label.Text =
            target.Name ..
            "\nHP: " ..
            health ..
            "/" ..
            maxHealth

    end

end

--==================================================
-- VIEW / SPECTATE
--==================================================

local function StopSpectating()

    Spectating = false

    local camera = workspace.CurrentCamera

    local character =
        GetCharacter(LocalPlayer)

    local humanoid =
        GetHumanoid(character)

    if humanoid then

        camera.CameraType =
            Enum.CameraType.Custom

        camera.CameraSubject =
            humanoid

    else

        camera.CameraType =
            Enum.CameraType.Custom

    end

    ViewButton.Text = "View Selected"

end

local function StartSpectating()

    if not SelectedPlayer then

        Title.Text = "NO TARGET"
        return

    end

    local character =
        GetCharacter(SelectedPlayer)

    if not character then

        Title.Text = "TARGET HAS NO CHARACTER"
        return

    end

    local humanoid =
        GetHumanoid(character)

    if not humanoid then

        Title.Text = "TARGET HAS NO HUMANOID"
        return

    end

    local camera =
        workspace.CurrentCamera

    camera.CameraType =
        Enum.CameraType.Custom

    camera.CameraSubject =
        humanoid

    Spectating = true

    ViewButton.Text = "Stop Viewing"

    Title.Text =
        "VIEW: " .. SelectedPlayer.Name

end

ViewButton.MouseButton1Click:Connect(function()

    if Spectating then
        StopSpectating()
    else
        StartSpectating()
    end

end)

--==================================================
-- TELEPORT
--==================================================

local function TeleportToSelected()

    if not SelectedPlayer then

        Title.Text = "NO TARGET"
        return

    end

    local myCharacter =
        GetCharacter(LocalPlayer)

    local targetCharacter =
        GetCharacter(SelectedPlayer)

    if not myCharacter then

        Title.Text = "NO CHARACTER"
        return

    end

    if not targetCharacter then

        Title.Text = "TARGET HAS NO CHARACTER"
        return

    end

    local myRoot =
        GetRoot(myCharacter)

    local targetRoot =
        GetRoot(targetCharacter)

    if not myRoot or not targetRoot then

        Title.Text = "ROOT PART MISSING"
        return

    end

    myRoot.CFrame =
        targetRoot.CFrame *
        CFrame.new(0, 0, 3)

    Title.Text =
        "TP: " .. SelectedPlayer.Name

end

TeleportButton.MouseButton1Click:Connect(
    TeleportToSelected
)

--==================================================
-- FLING
--==================================================

local function FlingSelected()

    if not SelectedPlayer then

        Title.Text = "NO TARGET"
        return

    end

    local character =
        GetCharacter(SelectedPlayer)

    if not character then

        Title.Text = "TARGET HAS NO CHARACTER"
        return

    end

    local root =
        GetRoot(character)

    if not root then

        Title.Text = "TARGET ROOT MISSING"
        return

    end

    root.AssemblyLinearVelocity =
        Vector3.new(
            math.random(-FlingPower, FlingPower),
            FlingPower,
            math.random(-FlingPower, FlingPower)
        )

    Title.Text =
        "FLUNG: " .. SelectedPlayer.Name

end

FlingButton.MouseButton1Click:Connect(
    FlingSelected
)

--==================================================
-- FLY
--==================================================

local function UpdateFly()

    if not Flying then
        return
    end

    local character =
        GetCharacter(LocalPlayer)

    if not character then
        return
    end

    local root =
        GetRoot(character)

    if not root then
        return
    end

    local camera =
        workspace.CurrentCamera

    local direction =
        Vector3.zero

    if UserInputService:IsKeyDown(
        Enum.KeyCode.W
    ) then

        direction =
            direction + camera.CFrame.LookVector

    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.S
    ) then

        direction =
            direction - camera.CFrame.LookVector

    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.A
    ) then

        direction =
            direction - camera.CFrame.RightVector

    end

    if UserInputService:IsKeyDown(
        Enum.KeyCode.D
    ) then

        direction =
            direction + camera.CFrame.RightVector

    end

    if FlyUp then

        direction =
            direction + Vector3.new(0, 1, 0)

    end

    if FlyDown then

        direction =
            direction - Vector3.new(0, 1, 0)

    end

    if direction.Magnitude > 0 then

        direction =
            direction.Unit * FlySpeed

    end

    root.AssemblyLinearVelocity =
        direction

end

FlyButton.MouseButton1Click:Connect(function()

    Flying = not Flying

    if Flying then

        FlyButton.Text = "Fly: ON"

    else

        FlyButton.Text = "Fly: OFF"

        local character =
            GetCharacter(LocalPlayer)

        local root =
            GetRoot(character)

        if root then
            root.AssemblyLinearVelocity =
                Vector3.zero
        end

    end

end)

--==================================================
-- FLY UP / DOWN
--==================================================

UserInputService.InputBegan:Connect(
    function(input, processed)

        if processed then
            return
        end

        if input.KeyCode ==
            Enum.KeyCode.Space then

            FlyUp = true

        elseif input.KeyCode ==
            Enum.KeyCode.LeftControl then

            FlyDown = true

        end

    end
)

UserInputService.InputEnded:Connect(
    function(input)

        if input.KeyCode ==
            Enum.KeyCode.Space then

            FlyUp = false

        elseif input.KeyCode ==
            Enum.KeyCode.LeftControl then

            FlyDown = false

        end

    end
)

--==================================================
-- NOCLIP
--==================================================

NoclipButton.MouseButton1Click:Connect(function()

    Noclip = not Noclip

    if Noclip then

        NoclipButton.Text =
            "Noclip: ON"

    else

        NoclipButton.Text =
            "Noclip: OFF"

    end

end)

local function UpdateNoclip()

    if not Noclip then
        return
    end

    local character =
        GetCharacter(LocalPlayer)

    if not character then
        return
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            object.CanCollide = false

        end

    end

end

--==================================================
-- ESP BUTTONS
--==================================================

BoneButton.MouseButton1Click:Connect(function()

    BoneESP = not BoneESP

    if BoneESP then

        BoneButton.Text =
            "Bone ESP: ON"

    else

        BoneButton.Text =
            "Bone ESP: OFF"

        for target in pairs(BoneObjects) do
            RemoveBoneESP(target)
        end

    end

end)

HealthButton.MouseButton1Click:Connect(function()

    HealthESP = not HealthESP

    if HealthESP then

        HealthButton.Text =
            "Health ESP: ON"

    else

        HealthButton.Text =
            "Health ESP: OFF"

        for _, target in ipairs(
            Players:GetPlayers()
        ) do

            if target ~= LocalPlayer then
                RemoveHealthESP(target)
            end

        end

    end

end)

--==================================================
-- PLAYER SETUP
--==================================================

local function SetupPlayer(target)

    if target == LocalPlayer then
        return
    end

    if Connections[target] then

        for _, connection in ipairs(
            Connections[target]
        ) do

            if connection then
                connection:Disconnect()
            end

        end

    end

    Connections[target] = {}

    table.insert(
        Connections[target],

        target.CharacterAdded:Connect(
            function()

                task.wait(0.3)

                if BoneESP then
                    CreateBoneESP(target)
                end

                if HealthESP then
                    UpdateHealthESP(target)
                end

            end
        )
    )

end

for _, target in ipairs(
    Players:GetPlayers()
) do

    SetupPlayer(target)

end

--==================================================
-- PLAYER ADDED
--==================================================

Players.PlayerAdded:Connect(function(target)

    SetupPlayer(target)

    task.wait(0.1)

    RefreshPlayerList()

end)

--==================================================
-- PLAYER REMOVED
--==================================================

Players.PlayerRemoving:Connect(function(target)

    if SelectedPlayer == target then

        SelectedPlayer = nil

        Title.Text =
            "LOCAL-HALF"

    end

    RemoveBoneESP(target)
    RemoveHealthESP(target)

    if Connections[target] then

        for _, connection in ipairs(
            Connections[target]
        ) do

            if connection then
                connection:Disconnect()
            end

        end

        Connections[target] = nil

    end

    RefreshPlayerList()

end)

--==================================================
-- MAIN UPDATE
--==================================================

RunService.Heartbeat:Connect(function()

    UpdateFly()
    UpdateNoclip()

    for _, target in ipairs(
        Players:GetPlayers()
    ) do

        if target ~= LocalPlayer then

            local character =
                GetCharacter(target)

            if character then

                --==================================
                -- BONE ESP
                --==================================

                if BoneESP then

                    if not BoneObjects[target] then

                        CreateBoneESP(target)

                    end

                end

                --==================================
                -- HEALTH ESP
                --==================================

                if HealthESP then

                    UpdateHealthESP(target)

                end

            end

        end

    end

    --==============================================
    -- KEEP SPECTATE WORKING AFTER RESPAWN
    --==============================================

    if Spectating and SelectedPlayer then

        local targetCharacter =
            GetCharacter(SelectedPlayer)

        local targetHumanoid =
            GetHumanoid(targetCharacter)

        if targetHumanoid then

            local camera =
                workspace.CurrentCamera

            if camera.CameraSubject ~=
                targetHumanoid then

                camera.CameraType =
                    Enum.CameraType.Custom

                camera.CameraSubject =
                    targetHumanoid

            end

        end

    end

end)

--==================================================
-- LOCAL PLAYER RESPAWN
--==================================================

LocalPlayer.CharacterAdded:Connect(function()

    task.wait(0.5)

    if Flying then

        FlyButton.Text =
            "Fly: ON"

    end

    if Spectating then

        task.wait(0.5)

        if SelectedPlayer then
            StartSpectating()
        end

    end

end)

--==================================================
-- START
--==================================================

print(
    "LOCAL-HALF loaded successfully"
)
